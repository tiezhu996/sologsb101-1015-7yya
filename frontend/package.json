{
  "name": "gbheritagetree-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "古树名木复壮养护档案 - 纯前端 SPA（Vue 3 + TypeScript + Element Plus + Vite + Pinia + Vue Router + Dexie）",
  "scripts": {
    "dev": "vite --host --port 22815",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host --port 22815",
    "typecheck": "vue-tsc --noEmit",
    "test:schedule": "esbuild scripts/test-schedule.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-schedule.mjs && node node_modules/.cache/test-schedule.mjs",
    "test:confirm": "esbuild scripts/test-confirm.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/test-confirm.mjs && node node_modules/.cache/test-confirm.mjs",
    "test": "npm run test:schedule && npm run test:confirm"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "dexie": "^4.0.11",
    "element-plus": "^2.9.5",
    "pinia": "^2.3.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "fake-indexeddb": "^6.2.5",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vue-tsc": "^2.2.0"
  }
}
